<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.production.management.mapper.entity.StockDetailMapper">
	<select id="getStockDetailByItemId" resultType="com.production.management.entity.StockDetailEntity">
	SELECT
	    item_id
	    , stock_qty
	    , defect_qty
	    , hold_qty
	    , allocated_qty
	    , updated_at
	FROM
	    public.stock_detail 
	WHERE
	    item_id = #{itemId}
	ORDER BY
	    item_id
	</select>
</mapper>